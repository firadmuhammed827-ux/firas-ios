    "code.build.couldNotQueue" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذّر بدء البناء على الخادم بعد عدة محاولات. حاول مرة أخرى لاحقاً." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "The server could not start this build after several attempts. Try again later." } } } },
    "code.build.expired" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "انتهت صلاحية هذا البناء على الخادم ولم تعد نتيجته متاحة. يمكنك بدء بناء جديد." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "This build expired on the server and its result is no longer available. You can start a new build." } } } },
