    "code.building" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يخطط للملفات ويكتبها ويربطها" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Planning, writing, and wiring files" } } } },
