    "code.hero.detail" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "صِف ما تريد، وسيخطط فِراس للملفات ويبنيها. عدّل الكود وشاهد النتيجة مباشرة على iPhone أو iPad." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Describe what you want and Firas will plan and build the files. Edit code and preview it directly on iPhone or iPad." } } } },
