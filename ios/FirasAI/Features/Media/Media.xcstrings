    "media.source.reading": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجهيز صورة المصدر…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing source image…"
          }
        }
      }
    },
    "media.source.unreadable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة الصورة. اختر صورة أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image could not be read. Choose another image."
          }
        }
      }
    },
    "media.source.tooLarge": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصورة أكبر من الحد المسموح لهذا الطلب. اختر صورة أصغر."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image exceeds the limit for this request. Choose a smaller image."
          }
        }
      }
    },
    "media.source.imageDetail": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف صورة إذا أردت تعديلها. بدون صورة، ينشئ فِراس صورة من الوصف."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a source image to edit it. Without one, Firas creates an image from your description."
          }
        }
      }
    },
    "media.source.videoDetail": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك إضافة صورة لتحريكها إلى فيديو."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can add a source image to animate into a video."
          }
        }
      }
    },
