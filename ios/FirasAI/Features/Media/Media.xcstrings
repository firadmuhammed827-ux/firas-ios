    "media.unconfirmed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تأكيد نتيجة الطلب الأصلي. لم يُرسل طلب إنشاء آخر."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original result could not be confirmed. It has not been submitted again."
