    "media.runningCloud": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك مغادرة التطبيق؛ سيواصل فِراس الإنشاء في السحابة ويرسل إشعاراً عند الانتهاء."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can leave the app. Firas keeps creating in the cloud and notifies you when it is ready."
          }
