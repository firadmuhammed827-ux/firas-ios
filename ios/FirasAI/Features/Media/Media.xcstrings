    "media.hero.detail": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صور وأغلفة وبانرات وفيديو وموسيقى بهوية فِراس. يمكنك المغادرة؛ تستمر المهمة في السحابة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images, covers, banners, video, and music in the Firas visual world. You can leave while the cloud job continues."
          }
        }
      }
    },
