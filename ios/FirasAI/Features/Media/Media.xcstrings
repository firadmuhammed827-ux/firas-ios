    "media.brief.tooLong": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النص يتجاوز حد الطلب. اختصره قبل الإنشاء؛ لن نحذف منه تلقائيًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This text exceeds the request limit. Shorten it before creating; it will not be cut automatically."
          }
        }
      }
    },
    "media.source.image": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صورة المصدر"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source image"
          }
        }
      }
    },
