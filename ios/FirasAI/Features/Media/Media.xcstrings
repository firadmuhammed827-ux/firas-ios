            "state": "translated",
            "value": "Source image used"
          }
        }
      }
    },
    "media.source.dimensionsTooLarge": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبعاد الصورة كبيرة جدًا لتجهيزها على الجهاز. اختر نسخة أصغر."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image dimensions are too large for local preparation. Choose a smaller copy."
