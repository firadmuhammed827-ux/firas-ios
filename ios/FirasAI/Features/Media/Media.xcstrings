    "media.result.load": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح النتيجة المحفوظة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open saved result"
          }
        }
      }
    },
    "media.result.loadDetail": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحمّل النتيجة الموجودة فقط؛ لا يُرسل طلب إنشاء جديد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads the existing result only; no new creation request is sent."
          }
        }
      }
    },
    "media.remove.confirm": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة هذه النتيجة من الجهاز؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this result from this device?"
