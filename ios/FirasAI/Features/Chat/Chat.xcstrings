    "context.brain.detail": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث في مصادر برين المحفوظة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search your saved Brain sources"
          }
        }
      }
    },
    "context.camera": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكاميرا"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera"
          }
        }
      }
    },
    "context.camera.accessDenied": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صلاحية الكاميرا غير متاحة. يمكنك تفعيلها من إعدادات iOS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is unavailable. You can enable it in iOS Settings."
          }
        }
      }
    },
    "context.camera.setupRequired": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج الكاميرا إلى وصف خصوصية NSCameraUsageDescription في إعدادات التطبيق."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera needs an NSCameraUsageDescription privacy entry in the app configuration."
          }
        }
      }
    },
    "context.camera.unavailable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكاميرا غير متاحة على هذا الجهاز."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera is unavailable on this device."
          }
        }
      }
    },
    "context.clear": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسح"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear"
          }
        }
      }
