        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add context"
          }
        }
      }
    },
    "composer.microphone": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإدخال الصوتي"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice input"
          }
        }
      }
    },
    "composer.startVoiceCall": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدء مكالمة صوتية"
          }
