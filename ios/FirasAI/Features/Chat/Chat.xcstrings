      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التفكير الموسّع"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extended thinking"
          }
        }
      }
    },
    "context.thinking.detail": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امنح فِراس وقتًا إضافيًا للمسائل المعقّدة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give Firas more time for complex work"
          }
        }
      }
    },
    "context.selectedLocally": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم اختيار السياق على الجهاز"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Context selected on this device"
          }
        }
      }
    },
    "context.backendRequired": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إرسال الصور والملفات بانتظار ربط مستخرج الملفات وواجهة الرفع في الباكند. أزل المرفقات لإرسال النص الآن."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending photos and files is waiting for the backend extractor and upload endpoint. Remove attachments to send text now."
          }
        }
      }
    },
    "context.unavailable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قريبًا"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coming soon"
          }
        }
      }
    },
    "context.unavailable.detail": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصور والكاميرا والملفات بانتظار ربط صلاحيات iOS وخدمة استخراج الملفات في الباكند."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos, camera, and files are waiting for iOS permissions and the backend file extractor."
          }
        }
      }
    },
    "context.webSearch": {
      "localizations": {
