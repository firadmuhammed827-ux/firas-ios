    "composer.selectModel": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختيار نموذج فِراس"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a Firas model"
          }
        }
      }
    },
    "composer.voiceUnavailable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإدخال الصوتي بانتظار ربط خدمة النسخ الصوتي."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice input is waiting for the transcription service connection."
          }
        }
      }
    },
    "context.brain": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فِراس برين"
          }
        },
