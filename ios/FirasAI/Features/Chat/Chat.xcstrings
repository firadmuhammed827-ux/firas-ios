      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد صور حديثة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No recent photos"
          }
        }
      }
    },
    "context.photos.importFailed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة هذه الصورة. اختر صورة أخرى وحاول مجددًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image could not be read. Choose another image and try again."
          }
        }
      }
    },
    "context.photos.limit": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك إرفاق عشر صور كحد أقصى في الرسالة الواحدة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can attach up to ten images to one message."
          }
        }
      }
    },
    "context.photos.recent": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صورة حديثة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recent photo"
          }
        }
      }
    },
    "context.photos.setupRequired": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعداد صلاحية الصور مطلوب"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo privacy setup needed"
          }
        }
      }
    },
    "context.processing": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لحظة، فِراس يجهّز الصور والملفات قبل الإرسال…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One moment — Firas is preparing the images and files before sending…"
          }
        }
      }
    },
    "context.ready": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السياق جاهز للإرسال مع رسالتك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Context is ready to send with your message"
          }
        }
      }
    },
