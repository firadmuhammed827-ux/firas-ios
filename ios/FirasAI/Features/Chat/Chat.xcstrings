    "notice.dismiss": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إخفاء التنبيه"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dismiss notice"
          }
        }
      }
    },
    "voice.audioRouteFailed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تغيير مخرج الصوت. تحقق من السماعة أو البلوتوث."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audio route could not be changed. Check the speaker or Bluetooth connection."
          }
        }
      }
    },
    "voice.connected": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصوت حي ومشفّر عبر جلسة مؤقتة — تكلّم بصورة طبيعية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live audio is connected with a temporary session — speak naturally."
          }
        }
      }
    },
    "voice.connecting": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جاري الاتصال"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting"
          }
        }
      }
    },
    "voice.connectionFailed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر بدء المكالمة الآن. تحقق من الاتصال وحاول مجددًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The call could not start right now. Check your connection and try again."
          }
        }
      }
    },
    "voice.connectionLost": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع الاتصال الصوتي. يمكنك إنهاء المكالمة والمحاولة مجددًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The live audio connection was lost. End the call and try again."
          }
        }
      }
    },
    "voice.connectionPending": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نجهّز جلسة الصوت المباشر الآمنة…"
          }
        },
