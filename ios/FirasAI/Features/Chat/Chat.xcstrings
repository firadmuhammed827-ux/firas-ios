    "context.files": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملفات"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files"
          }
        }
      }
    },
    "context.files.detail": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مستندات من تطبيق الملفات"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose documents from the Files app"
          }
        }
      }
    },
    "context.files.importFailed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر استيراد الملفات المحددة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected files could not be imported."
          }
        }
      }
    },
    "context.files.limit": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك إرفاق خمسة ملفات كحد أقصى في الرسالة الواحدة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can attach up to five files to one message."
          }
        }
      }
    },
    "context.files.officeUseBrain": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح ملف Word أو PowerPoint أو Excel في فِراس Brain حتى تبقى إحالات الأقسام والشرائح والجداول دقيقة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Word, PowerPoint, or Excel files in Firas Brain so section, slide, and sheet citations stay accurate."
          }
        }
      }
    },
    "context.files.truncated": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملف كبير؛ أُرسل الجزء الآمن للمحادثة. استخدم Brain لقراءة المستند كاملًا مع إحالات الصفحات."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file is large; the safe chat portion was attached. Use Brain for the full document with page citations."
          }
        }
      }
    },
    "context.photos": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصور"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos"
          }
        }
      }
    },
    "context.photos.accessDenied": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بالصور الحديثة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow recent photos"
          }
        }
      }
    },
    "context.photos.all": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل الصور"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All Photos"
