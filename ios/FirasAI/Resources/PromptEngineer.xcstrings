        }
      }
    },
    "choose": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر لغة الصياغة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the prompt language"
          }
        }
      }
    },
    "stop": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop"
          }
        }
      }
    },
    "apply": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطبيق على النص الحالي"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply to current draft"
          }
        }
      }
    },
    "replaceHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستبدل نص مربع الكتابة ويبقي المرفقات."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replaces the draft text and keeps its attachments."
          }
        }
      }
    },
    "partial": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه صياغة جزئية؛ لم يكتمل الطلب."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This prompt is partial; the request did not finish."
          }
        }
      }
    },
    "done": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        }
      }
    },
    "reconnect": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متابعة الحالة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check original job"
          }
        }
      }
    },
    "background": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك المغادرة. يواصل الطلب عمله في السحابة؛ الإيقاف يحتاج زر إيقاف."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can leave. The job continues in the cloud; only Stop cancels it."
          }
        }
      }
    },
    "applied": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طُبّقت الصياغة على مسودتك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The prompt was applied to your draft."
          }
        }
      }
    },
    "forget": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة المرجع من التطبيق"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove reference from app"
          }
        }
      }
    },
    "forgetHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل المرجع المحلي فقط. قد يستمر الطلب في السحابة؛ لا يوقفه ولا يعيد إرساله. تبقى مسودتك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes only the local reference. The cloud job may still run; this does not stop or resubmit it. Your draft stays."
          }
        }
      }
    },
    "preparing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ التحضير"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing"
          }
        }
      }
    },
