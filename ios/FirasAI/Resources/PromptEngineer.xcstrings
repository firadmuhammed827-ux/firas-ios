          "stringUnit": {
            "state": "translated",
            "value": "لم تُؤكّد النتيجة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outcome unconfirmed"
          }
        }
      }
    },
