          }
        }
      }
    },
    "input_invalid": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف طلبك مع /prompteng بحد أقصى ٨٬٠٠٠ محرف."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your request with /prompteng, up to 8,000 characters."
          }
        }
      }
    },
    "storage_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ رقم الطلب بأمان. احتُفظ بالنص دون إعادة الإرسال."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The job reference could not be saved safely. Your draft was kept without resubmission."
          }
        }
      }
    },
    "output_too_large": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجاوزت الصياغة حد العرض المدعوم. لم يُرسل طلب بديل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The prompt exceeded the supported display limit. No replacement job was sent."
          }
        }
      }
    },
    "stop_unconfirmed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُؤكّد الإيقاف. يمكنك متابعة الطلب الأصلي أو محاولة إيقافه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop is unconfirmed. Check the original job or try Stop again."
          }
        }
      }
    },
    "generation_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إكمال الصياغة. احتُفظ بطلبك وبأي نص متاح."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The prompt could not finish. Your request and available text were kept."
          }
        }
      }
    },
    "receipt_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تأكيد حالة الطلب الأصلي. لا نعيد إرساله تلقائياً."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original job could not be confirmed. It is never automatically resubmitted."
          }
        }
      }
    }
  },
  "version": "1.0"
