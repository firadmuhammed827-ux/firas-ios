      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ كتابة الصياغة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writing your prompt"
          }
        }
      }
    },
