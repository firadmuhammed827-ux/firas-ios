      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكتمل الطلب"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request did not finish"
          }
        }
      }
    },
    "stopped": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
